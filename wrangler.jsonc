{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitch-builder",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}