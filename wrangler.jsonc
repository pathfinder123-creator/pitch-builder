{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pitch-builder",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "vars": {
  "ALLOWED_ORIGINS": "https://pathfinder123-creator.github.io"
}
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
