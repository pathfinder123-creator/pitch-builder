{
  "name": "pitch-builder",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://pathfinder123-creator.github.io,https://pitch-builder-mu.vercel.app"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1009",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
